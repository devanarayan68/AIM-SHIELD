# AIM-SHIELD v2 Environment Configuration
# Copy this to .env and customize for your deployment

# ============== FLASK SETTINGS ==============
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# ============== SERVER SETTINGS ==============
HOST=0.0.0.0
PORT=5000
REQUEST_TIMEOUT=30

# ============== DATABASE ==============
DATABASE_PATH=aim_shield.db
DATABASE_URL=sqlite:///aim_shield.db

# ============== LOGGING ==============
LOG_LEVEL=INFO
LOG_FILE=aim_shield.log

# ============== WEBSOCKET ==============
CORS_ORIGINS=localhost,127.0.0.1,http://localhost:8000,http://localhost:8080
METRICS_EMISSION_INTERVAL=2
ENABLE_WEBSOCKET=true

# ============== DATA RETENTION ==============
METRICS_HISTORY_LIMIT=1000
LOGS_HISTORY_LIMIT=500
ALERTS_RETENTION_DAYS=30

# ============== ALERT THRESHOLDS ==============
# CPU
CPU_WARNING=70
CPU_CRITICAL=85

# Memory
MEMORY_WARNING=75
MEMORY_CRITICAL=90

# Latency (ms)
LATENCY_WARNING=200
LATENCY_CRITICAL=500

# Requests Per Second
RPS_WARNING=400
RPS_CRITICAL=550

# Failure Probability (0-1)
FAIL_PROB_WARNING=0.45
FAIL_PROB_CRITICAL=0.70

# Anomaly Score (0-1)
ISO_SCORE_WARNING=0.5
ISO_SCORE_CRITICAL=0.8

# ============== ML MODEL SETTINGS ==============
MODELS_DIR=models
ISO_CONTAMINATION=0.15
RF_MAX_DEPTH=10
TFIDF_MAX_FEATURES=500
LR_C=1.0

# ============== FEATURE FLAGS ==============
ENABLE_WEBSOCKET=true
ENABLE_DATABASE=true
ENABLE_ALERTS=true
ENABLE_HISTORY=true

# ============== PERFORMANCE ==============
MAX_WORKERS=4

# ============== OPTIONAL: PRODUCTION FEATURES ==============
# For database connection pooling
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# For metrics export (Prometheus)
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090

# For authentication
ENABLE_AUTH=false
JWT_SECRET=your-jwt-secret
JWT_EXPIRE_HOURS=24

# For distributed systems
REDIS_URL=redis://localhost:6379/0
MESSAGE_QUEUE=redis://localhost:6379/0
